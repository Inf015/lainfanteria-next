# Plantilla de variables de entorno.
# Copiar a .env.local (que está en .gitignore) y completar con valores reales.
# NUNCA poner valores reales en este archivo.

# --- Supabase -------------------------------------------------------------
# Panel de Supabase > Project Settings > API
# La anon key es pública por diseño: va al navegador y está limitada por RLS.
NEXT_PUBLIC_SUPABASE_URL=https://<tu-proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<tu-anon-key>

# La service role key SALTA RLS. Solo para el backoffice (fase 4), nunca en
# código que llegue al navegador y nunca con el prefijo NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=<tu-service-role-key>

# --- Cloudinary -----------------------------------------------------------
# Las fotos ya subidas siguen sirviéndose desde Cloudinary. Solo hace falta
# el cloud name para construir URLs; las claves recién se necesitan cuando el
# backoffice vuelva a subir imágenes.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=<tu-cloud-name>
# CLOUDINARY_API_KEY=<tu-api-key>
# CLOUDINARY_API_SECRET=<tu-api-secret>
